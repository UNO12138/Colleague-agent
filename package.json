{
  "name": "colleague-agent-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Browser and Electron prototype of the Colleague Agent collaboration timeline",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^38.0.0",
    "vite": "^7.1.12",
    "wait-on": "^8.0.3"
  }
}
