{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["plan_revision", "discussion", "task_change", "decision_request"]
    },
    "message": { "type": "string" },
    "planSummary": { "type": "string" },
    "changeSummary": { "type": "string" },
    "taskCard": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "statusText": { "type": "string" },
        "steps": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 0,
          "maxItems": 8
        }
      },
      "required": ["title", "statusText", "steps"],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "required": { "type": "boolean" },
        "title": { "type": "string" },
        "detail": { "type": "string" },
        "command": { "type": "string" },
        "subject": { "type": "string" },
        "tags": {
          "type": "array",
          "description": "决策标签固定顺序：类型、细分类型、风险程度。",
          "items": { "type": "string" },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": ["required", "title", "detail", "command", "subject", "tags"],
      "additionalProperties": false
    }
  },
  "required": ["kind", "message", "planSummary", "changeSummary", "taskCard", "decision"],
  "additionalProperties": false
}
